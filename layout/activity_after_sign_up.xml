<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AfterSignUp">

    <FrameLayout
        android:id="@+id/keyboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="gone"
        android:background="#EEEEEE" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/keyboard_container"
        android:fillViewport="true"
        android:padding="30dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/characterRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                tools:listitem="@layout/item_character_display"
                />

            <TextView
                android:id="@+id/text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:layout_below="@id/characterRecyclerView" android:text="Type the above text below and click submit when you are finished:-"
                android:layout_centerHorizontal="true"
                android:textColor="#2196F3"
                android:textSize="20sp"
                android:textStyle="italic" />

            <ProgressBar
                android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_below="@id/text2"
                android:layout_marginTop="20dp"
                android:progressTint="#4CAF50"
                android:max="100" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/progressBar" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:hint="Type the text here"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="10dp"
                app:startIconDrawable="@drawable/baseline_text_fields_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInput" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/submit_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/textInputLayout" android:text="Submit"
                android:textSize="20sp"
                android:layout_centerHorizontal="true" />

            <Button
                android:id="@+id/refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/submit_button"
                android:layout_marginTop="20dp"
                android:text="Refresh"
                android:textSize="20sp"
                android:layout_centerHorizontal="true" />

            <Button
                android:id="@+id/lout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/refresh"
                android:layout_marginTop="20dp"
                android:text="Logout"
                android:textSize="20sp"
                android:layout_centerHorizontal="true" />

        </RelativeLayout>
    </ScrollView>

</RelativeLayout>